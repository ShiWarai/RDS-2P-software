# Скопируйте в ~/.config/mirea_rag/mirea_rag.env и заполните.
# Секреты в git/образ не кладём.

# --- Бэкенд OSM+LLM: api | local ---
# api   — прежний HTTP RAG API (OSM + /search + LLM на сервере)
# local — локальные ROS OSM (system-one), RKLLM и BM25 по bundle
#         (пакет уже содержит bundle; сеть не нужна).
# Значение по умолчанию можно задать здесь или параметром запуска backend:=…
# MIREA_RAG_BACKEND=api

# --- Режим API (сейчас) ---
RAG_API_URL=http://10.76.58.97:8090

# --- OSM-гат «про РТУ МИРЭА?» ---
OSM_ENABLED=true
OSM_BASE_URL=https://osm.robotics-rtuitlab.ru/api/v1
OSM_AUTH_TOKEN=CHANGE_ME
OSM_MODEL=kev-0.8b
OSM_MAX_STATE_CHARS=1400
OSM_GATE_TIMEOUT=3.0

# --- TTS/ASR ---
NOSPEAK_MODE=strip

# --- Локальный режим (полный retrieval) ---
# MIREA_RAG_BACKEND=local
# MIREA_RAG_BUNDLE=/home/orangepi/RDS-2P-software/ros_packages/share/mirea_rag_ros/bundle
MIREA_RAG_EMBEDDING_MODEL=/home/orangepi/models/Qwen3-Embedding-0.6B
