<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mirea_rag_ros</name>
  <version>0.2.0</version>
  <description>RAG-помощник РТУ МИРЭА для робота-панды: транскрипция → RAG → TTS. Содержит клиент RAG, OSM-гат, nospeak-фильтр и запечённый bundle.</description>
  <maintainer email="ubuntu@todo.todo">ubuntu</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rds_2p_audio</depend>
  <!-- Локальный бэкенд: SystemOne/Ask + ChatCompletion action. -->
  <depend>llm_msgs_ros</depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rkllm_ros</exec_depend>
  <exec_depend>system_one_ros</exec_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
