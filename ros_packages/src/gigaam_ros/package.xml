<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gigaam_ros</name>
  <version>0.1.0</version>
  <description>ROS2 пакет для распознавания речи на основе GigaAM CTC (RKNN / RK3588 NPU)</description>
  <maintainer email="zhuravliov.pav@yandex.ru">Zhuravliov Pavel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>audio_common_msgs</depend>
  <!-- общий топик /audio/transcription несёт vosk_ros/msg/Transcription -->
  <exec_depend>vosk_ros</exec_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
