# Статус одного мотора (критичные данные для движения)
uint8 motor_id

# Текущие значения (критичные для движения)
float64 position            # Текущая позиция в радианах
float64 velocity            # Текущая скорость в рад/с
float64 load                # Текущая нагрузка в % от максимальной (0.1% единиц)
bool enabled                # Включен ли мотор
bool error                  # Есть ли ошибка
