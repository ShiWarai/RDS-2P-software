<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rds_2p</name>
  <version>1.0.0</version>
  <description>Основной пакет четвероногого робота RDS-2P: URDF/меши, мост мотор↔суставы, launch и RViz/Gazebo конфигурация</description>
  <maintainer email="zhuravliov.pav@yandex.ru">ShiWarai</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ftservo_ros</depend>
  <depend>rviz_imu_plugin</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>teleop_twist_keyboard</depend>
  <depend>compressed_image_transport</depend>
  <depend>compressed_depth_image_transport</depend>

  <!-- Мета-launch: voice_system.launch.py (аудио — IncludeLaunchDescription в rds_2p_audio) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rds_2p_audio</exec_depend>
  <exec_depend>vosk_ros2</exec_depend>
  <exec_depend>paroli_ros2</exec_depend>
  <exec_depend>rds_2p_face</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
