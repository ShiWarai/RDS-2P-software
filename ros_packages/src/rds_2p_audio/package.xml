<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rds_2p_audio</name>
  <version>1.0.0</version>
  <description>Аудио для RDS-2P: нода воспроизведения с микшированием AudioStamped по frame_id и launch с audio_capturer</description>
  <maintainer email="zhuravliov.pav@yandex.ru">ShiWarai</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>audio_common</depend>
  <depend>audio_common_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sounddevice</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

