<mujoco model="rds-2p feetonly scene">
  <include file="rds-2p_feetonly.mjcf"/>
  
  <statistic center="0 0 0.1" extent="0.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="0 0 0"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="1024"/>
  </visual>

  <compiler usethread="true" angle="radian"/>
  <option iterations="1" ls_iterations="5" timestep="0.004" integrator="Euler">
    <flag eulerdamp="disable" passive="disable" midphase="disable" nativeccd="disable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="1.2" condim="3"/>

    <!-- Global coordinate axes visualization on the floor -->
    <!-- +X axis (red) -->
    <geom name="x_axis" type="cylinder" fromto="0 0 0.02 0.5 0 0.02" size="0.005" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    <geom name="x_arrow" type="cylinder" fromto="0.5 0 0.02 0.55 0 0.02" size="0.01" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    
    <!-- +Y axis (green) -->
    <geom name="y_axis" type="cylinder" fromto="0 0 0.02 0 0.5 0.02" size="0.005" rgba="0 1 0 1" contype="0" conaffinity="0"/>
    <geom name="y_arrow" type="cylinder" fromto="0 0.5 0.02 0 0.55 0.02" size="0.01" rgba="0 1 0 1" contype="0" conaffinity="0"/>
    
    <!-- Origin point -->
    <geom name="origin" type="sphere" pos="0 0 0.02" size="0.01" rgba="0 0 0 1" contype="0" conaffinity="0"/>
    
    <!-- Labels for axes -->
    <site name="x_label" pos="0.6 0 0.02" size="0.02" rgba="1 0 0 1"/>
    <site name="y_label" pos="0 0.6 0.02" size="0.02" rgba="0 1 0 1"/>
  </worldbody>
</mujoco>
