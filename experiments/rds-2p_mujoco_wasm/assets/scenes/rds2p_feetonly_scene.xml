<mujoco model="rds-2p feetonly scene">
  <include file="rds-2p_feetonly.mjcf"/>
  
  <statistic center="0 0 0.1" extent="0.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="0 0 0"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
  </visual>

  <compiler usethread="true" angle="radian"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.62 0.80 0.52" rgb2="0.70 0.86 0.58" markrgb="0.55 0.76 0.47"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="0.6" condim="3"/>
    <!-- Movable props: position, radius, mass, colour and contacts live here.
         contype/conaffinity=1 enables ball/floor, ball/robot and ball/ball contacts. -->
    <body name="ball_blue" pos="0.75 0 0.065">
      <freejoint name="ball_blue_joint"/>
      <geom name="ball_blue_geom" type="sphere" size="0.065" mass="0.08"
        rgba="0.04 0.18 0.95 1" contype="1" conaffinity="1"
        condim="6" friction="0.6 0.01 0.002" priority="2" solref="0.02 0.3"/>
    </body>
    <body name="ball_red" pos="0.55 0.32 0.065">
      <freejoint name="ball_red_joint"/>
      <geom name="ball_red_geom" type="sphere" size="0.065" mass="0.08"
        rgba="0.95 0.08 0.06 1" contype="1" conaffinity="1"
        condim="6" friction="0.6 0.01 0.002" priority="2" solref="0.02 0.3"/>
    </body>
    <body name="ball_green" pos="0.55 -0.32 0.065">
      <freejoint name="ball_green_joint"/>
      <geom name="ball_green_geom" type="sphere" size="0.065" mass="0.08"
        rgba="0.08 0.85 0.16 1" contype="1" conaffinity="1"
        condim="6" friction="0.6 0.01 0.002" priority="2" solref="0.02 0.3"/>
    </body>
  </worldbody>
</mujoco>
